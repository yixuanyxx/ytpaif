# Theme Lab — Environment Configuration Template
# Copy this file to `.env` and set your API keys: cp .env.example .env

# 1. MAKER (Generator): Google Gemini
#LLM_API_KEY=YOUR_GEMINI_KEY
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-3.5-flash-lite
# Gemini safety budget counts actual HTTP attempts across model fallbacks in a rolling 24 hours.
# GEMINI_DAILY_CALL_CAP=60
# Put this SQLite file on persistent storage when running more than one process.
# GEMINI_BUDGET_DB=/var/lib/ytpaif/gemini-budget.sqlite3
# PORT=8766

# 2. CHECKER (Verifier): Anthropic Claude
# CHECKER_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
# CHECKER_LLM_MODEL=claude-sonnet-5
# CHECKER_LLM_API_KEY=YOUR_CLAUDE_KEY

# Exposure extraction and taxonomy classification: production uses Claude.
# These default to the CHECKER_LLM_* Claude settings above when omitted.
# EXPOSURE_LLM_PROVIDER=claude
# EXPOSURE_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
# EXPOSURE_LLM_MODEL=claude-sonnet-5
# EXPOSURE_LLM_API_KEY=YOUR_CLAUDE_KEY

# Source-confidence uses EXPOSURE_LLM_PROVIDER as well. When the entire exposure
# pipeline is explicitly switched to Gemini for a test, these optional settings
# provide the Gemini confidence model/key.
# EXPOSURE_CONFIDENCE_GEMINI_API_KEY=YOUR_GEMINI_KEY
# EXPOSURE_CONFIDENCE_GEMINI_MODEL=gemini-3.8-flash

# 3. FINANCIAL DATA: reads saved reports and extracts figures from their text without Google Search grounding.
# FINANCIALS_LLM_API_KEY=YOUR_FINANCIALS_AI_KEY
# FINANCIALS_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
# FINANCIALS_LLM_MODEL=gemini-3.8-flash
# Ordered fallback policy for both Gemini keys. Each request moves down from its configured model.
# On HTTP 401, try another configured Gemini key and temporarily skip the rejected key.
# Empty GEMINI_MODEL_FALLBACKS disables model switching.
# GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-3.1-flash-lite

# 4. DATABASE: Supabase
# SUPABASE_URL=https://nbooiqdinttrgahiugbv.supabase.co
# SUPABASE_SECRET_KEY=your_supabase_secret_key

# 5. SOURCE LINK CACHE: local Redis on the production VPS
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PREFIX=ytpaif
# Tavily web index for unresolved thematic-exposure fallback (no Gemini grounding).
TAVILY_API_KEY=
# Limit automatic unresolved-company searches per Analyse All run.
# UNRESOLVED_SEARCH_BATCH_LIMIT=3

# Optional completion notifications for Short and Long AI Search.
# Copy search-notification-recipients.example.json to search-notification-recipients.json
# and fill its telegram_chat_ids array.
# SEARCH_NOTIFICATION_RECIPIENTS_FILE=/etc/ytpaif/search-notification-recipients.json
# SEARCH_TELEGRAM_BOT_TOKEN=
