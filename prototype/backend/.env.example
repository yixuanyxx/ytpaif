# Theme Lab — Environment Configuration Template
# Copy this file to `.env` and set your API keys: cp .env.example .env

# 1. MAKER (Generator): Google Gemini
#LLM_API_KEY=YOUR_GEMINI_KEY
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MAX_CALLS=100
# PORT=8766

# 2. CHECKER (Verifier): Anthropic Claude
# CHECKER_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
# CHECKER_LLM_MODEL=claude-sonnet-5
# CHECKER_LLM_API_KEY=YOUR_CLAUDE_KEY

# 3. FINANCIAL DATA SEARCH: separate AI key for source-backed market-cap and revenue lookup
# FINANCIALS_LLM_API_KEY=YOUR_FINANCIALS_AI_KEY
# FINANCIALS_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
# FINANCIALS_LLM_MODEL=gemini-3.8-flash

# 4. DATABASE: Supabase
# SUPABASE_URL=https://nbooiqdinttrgahiugbv.supabase.co
# SUPABASE_SECRET_KEY=your_supabase_secret_key

# 5. SOURCE LINK CACHE: local Redis on the production VPS
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PREFIX=ytpaif
# Optional Tavily web index for discovery on approved source sites.
TAVILY_API_KEY=

# Optional completion notifications for Short and Long AI Search.
# Copy search-notification-recipients.example.json to search-notification-recipients.json
# and fill its telegram_chat_ids array.
# SEARCH_NOTIFICATION_RECIPIENTS_FILE=/etc/ytpaif/search-notification-recipients.json
# SEARCH_TELEGRAM_BOT_TOKEN=
