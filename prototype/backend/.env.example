# Theme Lab — Environment Configuration Template
# Copy this file to `.env` and set your API key:  cp .env.example .env
# Only the API key is required. All other settings have built-in defaults.

# Google AI Studio / Gemini API key
LLM_API_KEY=YOUR_KEY

# Optional overrides (defaults are built-in):
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-3-flash-preview
# LLM_MAX_CALLS=100
# PORT=8766
