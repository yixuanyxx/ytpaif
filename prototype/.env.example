# Theme Lab — environment template.
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# The `.env` file is gitignored; this template is safe to commit.
# Real shell environment variables override anything set in `.env`.

# OpenAI-compatible Chat Completions endpoint
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Model name your provider exposes (e.g. gpt-4o-mini)
LLM_MODEL=YOUR_COMPATIBLE_MODEL

# Your provider API key
LLM_API_KEY=YOUR_KEY

# Persistent workspace call cap (incl. retries). 0 = AI disabled.
# Each company uses 2 calls; taxonomy generation uses 1.
LLM_MAX_CALLS=0

# Optional: relocate SQLite/source storage
# THEME_DATA_DIR=

# Optional: change the HTTP port (default 8765)
# PORT=8765
